# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Payment Provider API Configuration
# Replace with your actual payment provider credentials
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_API_URL=your_payment_api_url_here

# PesaFlux API Configuration (if using PesaFlux)
PESAFLUX_API_KEY=your_pesaflux_api_key_here
PESAFLUX_API_URL=your_pesaflux_api_url_here
PESAFLUX_MERCHANT_ID=your_merchant_id_here

# Database Configuration (if using Supabase or other)
DATABASE_URL=your_database_url_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
